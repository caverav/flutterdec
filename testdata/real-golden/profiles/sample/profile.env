# Real binary input path. Prefer INPUT_ENV for machine-local paths.
# INPUT=/absolute/path/to/sample.apk
INPUT_ENV=FLUTTERDEC_REAL_GOLDEN_SAMPLE_INPUT

# Optional tuning overrides.
MAX_FUNCTIONS=120
MIN_DISASSEMBLY_RATIO=0.0

# Optional custom files list; defaults to <BASELINE>/files.txt.
# FILES=testdata/real-golden/profiles/sample/files.txt

# Optional explicit baseline path; defaults to this profile directory.
# BASELINE=testdata/real-golden/profiles/sample
